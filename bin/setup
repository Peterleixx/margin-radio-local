#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
umask 077
case "$(uname -s)" in
  Darwin)
    if ! command -v ffmpeg >/dev/null 2>&1; then
      command -v brew >/dev/null 2>&1 || { echo "请先安装 Homebrew 或 FFmpeg，然后重新运行 bin/setup。" >&2; exit 1; }
      brew install ffmpeg
    fi ;;
  Linux)
    if ! command -v ffmpeg >/dev/null 2>&1; then
      command -v apt-get >/dev/null 2>&1 || { echo "请用系统包管理器安装 ffmpeg，然后重新运行 bin/setup。" >&2; exit 1; }
      if [ "$(id -u)" = 0 ]; then
        apt-get update && apt-get install -y ffmpeg
      else
        sudo apt-get update && sudo apt-get install -y ffmpeg
      fi
    fi ;;
  *) echo "请在 macOS 或 Linux 环境运行。" >&2; exit 1 ;;
esac
if command -v uv >/dev/null 2>&1; then
  runner=uv
else
  if [ ! -x .bootstrap/bin/uv ]; then
    command -v python3 >/dev/null 2>&1 || { echo "请先安装 Python 3（含 venv）或 uv。" >&2; exit 1; }
    python3 -m venv .bootstrap || { echo "请安装 Python 的 venv 模块，或安装 uv 后重试。" >&2; exit 1; }
    .bootstrap/bin/python -m pip install uv
  fi
  runner=.bootstrap/bin/uv
fi
"$runner" sync --locked --no-dev
ffmpeg -v error -nostdin -f lavfi -i anullsrc -t 0.1 -c:a libmp3lame -f mp3 - >/dev/null
echo "安装成功。运行 bin/margin-radio-web 启动节目库。"
